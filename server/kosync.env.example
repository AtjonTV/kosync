#
# Copy this file to "kosync.env" next to the executable and adjust it.
# Values already present in the environment win over the ones in the file.
#
# Everything else (listen address, data directory, SMTP, backups, rate limits,
# token lifetimes) belongs to PocketBase and is configured with its flags
# ("kosync serve --http=... --dir=...") or in the superuser interface at /_/.
#

# Serve the web interface. Requires an executable that was built with it,
# see docs/build.md.
ENABLE_WEBUI=true

# Refuse new accounts in the web interface. KOReader can never register on its
# own, because a device credential has to belong to an existing account.
DISABLE_REGISTRATION=false

# How long a day of reading statistics is kept in full detail.
ANALYTICS_RETENTION_DAYS=90

# What happens to a day that ages out: "aggregate" folds it into its month
# before removing it, "delete" simply drops it.
ANALYTICS_RETENTION_MODE=aggregate

# How often the background worker recomputes queued statistics days.
ANALYTICS_WORKER_INTERVAL_SECONDS=5
ANALYTICS_WORKER_BATCH_SIZE=50

# The longest pause between two progress updates that still counts as reading.
# KOReader reports positions, never durations, so reading time is an estimate.
ANALYTICS_SESSION_GAP_SECONDS=300

# How many recent days the weekly reconciliation job recomputes.
ANALYTICS_RECONCILE_DAYS=7

# How long a verified KOReader credential stays in the in-memory cache.
# Devices push every few pages and the stored credential is bcrypt hashed, so
# this keeps a sync from costing a full password verification every time.
# Set to 0 to disable caching. Rotating or disabling a credential always takes
# effect immediately, cached or not.
KOREADER_AUTH_CACHE_TTL_SECONDS=300
KOREADER_AUTH_CACHE_ENTRIES=1024

# Fallback reading density, used only for books whose page count cannot be
# measured from the reader's own progress. 155 is what an e-reader page holds in
# practice, well below the ~250 usually quoted for print.
BOOKS_WORDS_PER_PAGE=155

# How much room one account's uploaded books may take together, in megabytes.
# 0 means no limit, which is the right answer for a private instance. With a
# limit set, an upload that would not fit is refused and the library page shows
# how full it is. Only the EPUBs count, not the covers extracted from them.
BOOKS_QUOTA_MEGABYTES=0

# Serve the library as an OPDS catalog at /opds, so a reading device can browse
# and download from it. It shows one account its own books and asks for the same
# credential that account already syncs with.
ENABLE_OPDS=true

# How many books one page of a catalog feed holds. E-readers parse a whole page
# before drawing any of it.
OPDS_PAGE_SIZE=50

# Let the server tell an account by mail what it has earned. This is the
# operator's switch; the account has its own, under Account in the web
# interface, and it is off until somebody turns it on. SMTP is configured in the
# superuser interface, and without it nothing can be sent at all.
ENABLE_ACHIEVEMENT_MAIL=true

# Let the server send the weekly and monthly summaries of an account's own
# reading. This is the operator's switch; the account chooses the cadence under
# Account in the web interface, and no account has one until it does. A summary
# covers the period that has finished and arrives at eight in the morning in the
# account's own timezone. A period with no reading in it is not sent at all.
ENABLE_SUMMARY_MAIL=true
